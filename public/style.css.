@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
    --background: #08080d;
    --sidebar: #0d0d15;
    --surface: #12121d;
    --surface-hover: #1a1a29;
    --primary: #9333ea;
    --primary-light: #a855f7;
    --text: #f5f3ff;
    --muted: #9292a5;
    --border: #252536;
    --success: #22c55e;
    --danger: #ef4444;
    --radius: 14px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    background: var(--background);
    color: var(--text);
    font-family: 'Inter', sans-serif;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
    border: none;
}

a {
    color: inherit;
    text-decoration: none;
}

.dashboard {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 255px;
    min-height: 100vh;
    background: var(--sidebar);
    border-right: 1px solid var(--border);
    padding: 24px 16px;
    position: fixed;
    inset: 0 auto 0 0;
    overflow-y: auto;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    margin-bottom: 35px;
}

.logo-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: linear-gradient(135deg, #9333ea, #4c1d95);
    font-size: 22px;
    font-weight: 800;
}

.logo h2 {
    font-size: 19px;
    letter-spacing: 1px;
}

.logo span {
    display: block;
    color: var(--muted);
    font-size: 11px;
    margin-top: 3px;
}

.nav-title {
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 12px;
}

.nav-menu {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.nav-menu button {
    width: 100%;
    text-align: left;
    padding: 12px;
    color: var(--muted);
    background: transparent;
    border-radius: 10px;
    transition: .2s;
}

.nav-menu button:hover,
.nav-menu button.active {
    color: white;
    background: rgba(147, 51, 234, .16);
}

.nav-menu button.active {
    border-left: 3px solid var(--primary-light);
}

.main {
    flex: 1;
    margin-left: 255px;
    min-width: 0;
}

.topbar {
    height: 75px;
    padding: 0 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    background: rgba(13, 13, 21, .8);
}

.topbar h1 {
    font-size: 19px;
}

.user-profile {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 13px;
}

.avatar {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: var(--surface-hover);
    border-radius: 50%;
}

.content {
    padding: 30px;
    max-width: 1500px;
    margin: auto;
}

.welcome {
    margin-bottom: 28px;
}

.welcome h2 {
    font-size: 26px;
    margin-bottom: 9px;
}

.welcome p {
    color: var(--muted);
    font-size: 14px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    transition: .2s;
}

.card:hover {
    border-color: rgba(168, 85, 247, .5);
    transform: translateY(-2px);
}

.card h3 {
    font-size: 14px;
    margin-bottom: 14px;
}

.card p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
}

.stat {
    font-size: 28px;
    font-weight: 800;
    margin-top: 8px;
}

.primary-button {
    padding: 11px 17px;
    border-radius: 10px;
    color: white;
    background: var(--primary);
    font-weight: 600;
    transition: .2s;
}

.primary-button:hover {
    background: var(--primary-light);
}

.secondary-button {
    padding: 11px 17px;
    border-radius: 10px;
    color: var(--text);
    background: var(--surface-hover);
    border: 1px solid var(--border);
}

input,
select,
textarea {
    width: 100%;
    padding: 12px;
    color: var(--text);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 10px;
    outline: none;
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--primary-light);
}

.section {
    margin-top: 25px;
}

.section h2 {
    font-size: 18px;
    margin-bottom: 16px;
}

.badge {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 11px;
    background: rgba(147, 51, 234, .17);
    color: #c084fc;
}

.status-online {
    color: var(--success);
}

.status-offline {
    color: var(--danger);
}

.footer {
    padding: 25px;
    text-align: center;
    color: var(--muted);
    font-size: 12px;
}

@media (max-width: 900px) {
    .sidebar {
        width: 210px;
    }

    .main {
        margin-left: 210px;
    }

    .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 650px) {
    .sidebar {
        width: 65px;
        padding: 15px 7px;
    }

    .logo {
        justify-content: center;
        padding: 5px;
    }

    .logo h2,
    .logo span,
    .nav-title {
        display: none;
    }

    .nav-menu button {
        text-align: center;
        font-size: 0;
        padding: 13px 5px;
    }

    .nav-menu button::first-letter {
        font-size: 18px;
    }

    .main {
        margin-left: 65px;
    }

    .content {
        padding: 18px 12px;
    }

    .topbar {
        padding: 0 15px;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    .welcome h2 {
        font-size: 21px;
    }
}
